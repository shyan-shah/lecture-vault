# Copy to .env, or just run:  python setup_wizard.py  (it writes .env for you)

ANTHROPIC_API_KEY=
NOTES_MODEL=claude-sonnet-5-5
# One line describing you; every prompt uses it so the notes pitch at the right level
STUDENT_PROFILE=Year 3 MEng Mechanical Engineering student at the University of Bath

PANOPTO_HOST=https://uniofbath.cloud.panopto.eu
MOODLE_HOST=https://moodle.bath.ac.uk
# Your timetable iCal link (Bath: MyTimetable > Subscribe). Comma separate several.
TIMETABLE_ICS_URL=

STUDY_HOURS_PER_WEEK=20
AUTO_TRANSCRIBE=1          # process new recordings as soon as Panopto lists them
AUTO_SYNC_MINUTES=20       # how often to check Panopto
AUTO_SINCE_DAYS=14         # how far back auto mode looks
CAPTION_GRACE_HOURS=6      # wait this long for Panopto captions before falling back to Whisper
NOTIFY=1                   # Windows notifications
APP_PORT=8765
WHISPER_MODEL=small.en

# Optional, advanced: sync to your own Supabase (schema in migration.sql). Leave blank to keep everything local.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
VAULT_USER_ID=
